#!/usr/bin/env bash
set -euo pipefail
FROZEN=7725c5b
if git diff --cached --name-status | awk '$2 ~ /^prereg\// && !($1=="A" && $2 ~ /^prereg\/amendments\//) {bad=1} END{exit !bad}'; then
  echo "pre-commit: frozen preregistration modified (only new files in prereg/amendments/ allowed)" >&2; exit 1
fi
git diff --cached --quiet "$FROZEN" -- $(git ls-tree -r --name-only "$FROZEN" prereg/) \
  || { echo "pre-commit: prereg/ differs from $FROZEN" >&2; exit 1; }
if git diff --cached --name-only | grep -qx 'results/ledger.jsonl' && git cat-file -e HEAD:results/ledger.jsonl 2>/dev/null; then
  n=$(git show HEAD:results/ledger.jsonl | wc -c)
  cmp -s <(git show HEAD:results/ledger.jsonl) <(git show :results/ledger.jsonl | head -c "$n") \
    || { echo "pre-commit: ledger is append-only" >&2; exit 1; }
fi
if git diff --cached --name-only | grep -q '^paper/'; then
  python3 scripts/check_numbers.py
  git diff --cached --name-only | grep -q 'refs.bib' && python3 scripts/verify_bib.py
fi
exit 0
