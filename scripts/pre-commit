#!/usr/bin/env bash
# Installed as .git/hooks/pre-commit by scripts/install_guard.sh.
# 2026-11-25 (integrity incident INC-2026-11-25-required-macros): every frozen path in config/frozen_paths.json is
# now checked here, not only prereg/ and the ledger; paper/numbers.tex must be the output of a logged make_numbers run.
# The earlier checks are kept unchanged below.
set -euo pipefail
python3 scripts/frozen_guard.py check-staged || { echo "pre-commit: frozen-path check failed (scripts/frozen_guard.py)" >&2; exit 1; }
FROZEN=7725c5b
if git diff --cached --name-status | awk '$2 ~ /^prereg\// && !($1=="A" && $2 ~ /^prereg\/(amendments|deviations)\//) && !($1=="A" && ($2=="prereg/P2_prompt_vs_fact.md" || $2=="prereg/HASH_P2.txt")) && $2 != "prereg/INDEX.md" {bad=1} END{exit !bad}'; then
  echo "pre-commit: frozen preregistration modified (only new files in prereg/amendments/ or prereg/deviations/, and prereg/INDEX.md, allowed)" >&2; exit 1
fi
git diff --cached --quiet "$FROZEN" -- $(git ls-tree -r --name-only "$FROZEN" prereg/) \
  || { echo "pre-commit: prereg/ differs from $FROZEN" >&2; exit 1; }
if git diff --cached --name-only | grep -qx 'results/ledger.jsonl' && git cat-file -e HEAD:results/ledger.jsonl 2>/dev/null; then
  n=$(git show HEAD:results/ledger.jsonl | wc -c)
  cmp -s <(git show HEAD:results/ledger.jsonl) <(git show :results/ledger.jsonl | head -c "$n") \
    || { echo "pre-commit: ledger is append-only" >&2; exit 1; }
fi
if git diff --cached --name-only | grep -q '^paper/'; then
  python3 scripts/check_numbers.py
  git diff --cached --name-only | grep -q 'refs.bib' && python3 scripts/verify_bib.py
fi
exit 0
